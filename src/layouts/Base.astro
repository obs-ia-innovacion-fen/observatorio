---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
const { titulo, descripcion, portada = false, imagen = '/og.png' } = Astro.props;
const tituloCompleto = portada
  ? 'Observatorio de IA e Innovación en los Negocios · FEN Universidad de Chile'
  : `${titulo} · Observatorio de IA e Innovación en los Negocios`;
const canonica = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const imagenAbsoluta = Astro.site ? new URL(imagen, Astro.site).href : imagen;
const areas = (await getCollection('areas')).sort((a, b) => a.data.orden - b.data.orden);
const anio = new Date().getFullYear();

// Los logotipos institucionales se muestran solo si los archivos estan puestos.
const logos = [
  { archivo: 'uchile.svg', alt: 'Universidad de Chile' },
  { archivo: 'fen.svg', alt: 'Facultad de Economía y Negocios' },
].filter((l) => fs.existsSync(`./public/logos/${l.archivo}`));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Observatorio de IA e Innovación en los Negocios" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbsoluta} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* Paleta FEN: los dos azules del logotipo institucional */
        --fen: #0034D9;
        --fen-claro: #5868EB;
        --tinta: #0E1A3F;
        --papel: #F7F8FB;
        --niebla: #DCE1F0;
        --gris: #4F5B7A;
        --senal: var(--fen);
        --azul-claro: #E8ECFB;
        --alerta: #8a4b1f;

        --display: 'Archivo', system-ui, sans-serif;
        --cuerpo: 'Source Serif 4', Georgia, serif;
        --dato: 'IBM Plex Mono', ui-monospace, monospace;

        --medida: 68ch;
        --ancho: 1180px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--papel);
        color: var(--tinta);
        font-family: var(--cuerpo);
        font-size: 1.125rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .marco { max-width: var(--ancho); margin: 0 auto; padding: 0 1.5rem; }

      h1, h2, h3 { font-family: var(--display); font-weight: 600; line-height: 1.16; letter-spacing: -0.008em; margin: 0; }
      h1 { font-size: clamp(2.3rem, 5vw, 3.5rem); }
      h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
      h3 { font-size: 1.3rem; }

      a { color: var(--senal); text-underline-offset: 0.18em; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--senal); outline-offset: 3px; }

      /* Procedencia: el sistema que distingue a este sitio */
      .procedencia {
        font-family: var(--dato);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.22rem 0.5rem;
        border: 1px solid currentColor;
      }
      .procedencia[data-tipo='propio'] { background: var(--fen); color: #fff; border-color: var(--fen); }
      .procedencia[data-tipo='colaboracion'] { color: var(--tinta); border-width: 2px; }
      .procedencia[data-tipo='comentada'] { color: var(--senal); background: var(--azul-claro); border-color: var(--senal); }
      .procedencia[data-tipo='sugerencia'] { color: var(--gris); border-style: dashed; }

      .sitio-cabecera {
        border-top: 6px solid var(--fen);
        border-image: linear-gradient(90deg, var(--fen) 0 60%, var(--fen-claro)) 1;
        border-bottom: 1px solid var(--niebla);
        padding: 1.15rem 0;
        background: #fff;
      }
      .sitio-cabecera .marco { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: baseline; justify-content: space-between; }
      .marca { font-family: var(--display); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.01em; color: var(--fen); text-decoration: none; }
      .marca span { display: block; font-family: var(--dato); font-size: 0.78rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gris); margin-top: 0.2rem; }
      .menu { display: flex; gap: 1.6rem; font-family: var(--dato); font-size: 0.9rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.07em; }
      .menu a { color: var(--gris); text-decoration: none; }
      .menu a:hover { color: var(--fen); }

      main { padding: 3.5rem 0 5rem; }
      main.portada { padding: 0; }

      .identidad { display: flex; align-items: center; gap: 1.1rem; }
      .logos { display: flex; align-items: center; gap: 0.9rem; padding-right: 1.1rem; border-right: 1px solid var(--niebla); }
      .logos img { display: block; width: auto; }

      .sitio-pie { border-top: 3px solid var(--fen); padding: 1.6rem 0; font-size: 1rem; color: var(--gris); }
      .areas-pie { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; padding-bottom: 1.1rem; margin-bottom: 1.1rem; border-bottom: 1px solid var(--niebla); font-family: var(--dato); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
      .areas-pie span { color: var(--tinta); }
      .areas-pie a { color: var(--gris); text-decoration: none; }
      .areas-pie a:hover { color: var(--senal); text-decoration: underline; }
      .sitio-pie .pie { display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; justify-content: space-between; }
      .sitio-pie p { margin: 0; }

      @media (prefers-reduced-motion: no-preference) {
        a, .procedencia { transition: color 120ms ease, background 120ms ease; }
      }
    </style>
  </head>
  <body>
    <header class="sitio-cabecera">
      <div class="marco">
        <div class="identidad">
          {logos.length > 0 && (
            <span class="logos">
              {logos.map((l) => <img src={`/logos/${l.archivo}`} alt={l.alt} height="44" />)}
            </span>
          )}
          <a class="marca" href="/">
            Observatorio de IA e Innovación en los Negocios
            <span>Depto. de Administración · FEN · Universidad de Chile</span>
          </a>
        </div>
        <nav class="menu">
          <a href="/observatorio/">Observatorio</a>
          <a href="/datos/">Datos</a>
          <a href="/publicaciones/">Publicaciones</a>
          <a href="/recursos/">Recursos</a>
          <a href="/novedades/">Novedades</a>
          <a href="/webinars/">Webinars</a>
        </nav>
      </div>
    </header>

    <main class={portada ? 'portada' : ''}><slot /></main>

    <footer class="sitio-pie">
      <div class="marco">
        <nav class="areas-pie" aria-label="Áreas">
          <span>Áreas</span>
          {areas.map((a) => <a href={`/areas/${a.data.slug}/`}>{a.data.titulo}</a>)}
        </nav>
        <div class="pie">
          <p>
            Cada pieza declara su procedencia y el estatus de revisión de su
            fuente. <a href="/metodo/">Cómo trabajamos</a>
          </p>
          <p class="derechos">© {anio} · Universidad de Chile</p>
        </div>
      </div>
    </footer>
  </body>
</html>

---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import { idiomaDe, t, ruta, rutaEn, idiomas } from '../i18n/ui';
import { esVistaPrevia, ramaActual } from '../lib/contenido';
const { titulo, descripcion, portada = false, imagen = '/og.png', borrador = false } = Astro.props;
const idioma = idiomaDe(Astro.url);
const tituloCompleto = portada
  ? `${t(idioma, 'sitio.nombre')} · ${t(idioma, 'pie.derechos')}`
  : `${titulo} · ${t(idioma, 'sitio.nombre')}`;
const canonica = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const imagenAbsoluta = Astro.site ? new URL(imagen, Astro.site).href : imagen;
const areas = (await getCollection('areas')).sort((a, b) => a.data.orden - b.data.orden);
const anio = new Date().getFullYear();
const linkedin = 'https://www.linkedin.com/company/observatorioiaeinnovacion/';
const otros = Object.keys(idiomas).map((i) => ({ codigo: i, href: rutaEn(Astro.url, i), nombre: idiomas[i] }));
const og = { es: 'es_CL', en: 'en_US', pt: 'pt_BR' };

// Menu principal. "secciones" son los prefijos de URL que marcan la pestaña
// como activa mientras las paginas antiguas conviven con la estructura nueva.
const menu = [
  { clave: 'menu.inicio', href: '/', secciones: [] },
  { clave: 'menu.actividades', href: '/webinars/', secciones: ['/webinars/'] },
  { clave: 'menu.noticias', href: '/novedades/', secciones: ['/novedades/', '/radar/', '/prensa/'] },
  { clave: 'menu.investigacion', href: '/publicaciones/', secciones: ['/publicaciones/'] },
  { clave: 'menu.datos', href: '/datos/', secciones: ['/datos/'] },
  { clave: 'menu.recursos', href: '/recursos/', secciones: ['/recursos/'] },
  { clave: 'menu.nosotros', href: '/observatorio/', secciones: ['/observatorio/', '/metodo/', '/areas/'] },
] as const;
const camino = Astro.url.pathname.replace(/^\/(en|pt)(?=\/|$)/, '') || '/';
const activo = (item) =>
  item.href === '/' ? camino === '/' : item.secciones.some((s) => camino.startsWith(s));

// Los logotipos institucionales se muestran solo si los archivos estan puestos.
const logos = [
  { archivo: 'uchile.svg', alt: 'Universidad de Chile' },
  { archivo: 'fen.svg', alt: 'Facultad de Economía y Negocios' },
].filter((l) => fs.existsSync(`./public/logos/${l.archivo}`));
---

<!doctype html>
<html lang={idioma} data-tema="oscuro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {(esVistaPrevia || borrador) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(idioma, 'sitio.nombre')} />
    <meta property="og:locale" content={og[idioma]} />
    {otros.filter((o) => o.codigo !== idioma).map((o) => <link rel="alternate" hreflang={o.codigo} href={o.href} />)}
    <script is:inline>
      // Se aplica antes de pintar para que no haya parpadeo. Oscuro por defecto.
      try {
        const tema = localStorage.getItem('observatorio-tema');
        if (tema === 'claro' || tema === 'oscuro') document.documentElement.dataset.tema = tema;
      } catch (e) {}
    </script>
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbsoluta} />
    <link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      /* Tipografias alojadas en el sitio (public/fonts), segun el Manual de
         Normas Graficas FEN (p. 35-36): la corporativa es TT Wellingtons, con
         derechos gestionados por la Oficina de Comunicaciones y RR.PP.; la
         secundaria, para sistemas digitales cuando la corporativa no esta
         disponible, es Inter. Se usa Inter hasta contar con los archivos web
         licenciados de TT Wellingtons: entonces se agregan sus @font-face y se
         antepone su nombre en --display y --cuerpo. Nada mas cambia. */
      @font-face { font-family: 'Inter'; font-weight: 400; font-display: swap; src: url('/fonts/inter-latin-400-normal.woff2') format('woff2'); }
      @font-face { font-family: 'Inter'; font-weight: 500; font-display: swap; src: url('/fonts/inter-latin-500-normal.woff2') format('woff2'); }
      @font-face { font-family: 'Inter'; font-weight: 600; font-display: swap; src: url('/fonts/inter-latin-600-normal.woff2') format('woff2'); }
      @font-face { font-family: 'Inter'; font-weight: 700; font-display: swap; src: url('/fonts/inter-latin-700-normal.woff2') format('woff2'); }

      /* Paleta del Manual de Normas Graficas FEN (p. 33). Los nombres de las
         variables se conservan para no tocar las paginas: en modo oscuro
         --papel es el fondo, --tinta el texto, --niebla los bordes, y
         --superficie el fondo de tarjetas. --fen se mantiene igual en ambos
         modos porque siempre va con texto blanco encima. */
      :root {
        --fen: #0034D9;
        --fen-claro: #3B78DB;
        --alerta: #F03B4A;

        --display: 'TT Wellingtons', 'Inter', system-ui, sans-serif;
        --cuerpo: 'TT Wellingtons', 'Inter', system-ui, sans-serif;
        --dato: 'Inter', system-ui, sans-serif;

        --medida: 68ch;
        --ancho: 1180px;
      }

      /* Modo oscuro (por defecto): azul marino profundo, no negro, para que
         conviva con el azul FEN sin un contraste duro. */
      :root, :root[data-tema='oscuro'] {
        color-scheme: dark;
        --papel: #0E1A36;
        --superficie: #15244A;
        --tinta: #EAEFFA;
        --niebla: #273A68;
        --gris: #AAB6D3;
        --gris-medio: #7383A8;
        --marino: #B9C8FF;
        --senal: #8DB0FF;
        --azul-claro: #1A2D5C;
        --cabecera: rgba(14, 26, 54, 0.8);
        --pildora-activa: rgba(141, 176, 255, 0.14);
        --pildora-borde: rgba(141, 176, 255, 0.4);
      }

      /* Modo claro: la paleta original del manual. */
      :root[data-tema='claro'] {
        color-scheme: light;
        --papel: #F4F5F4;
        --superficie: #FFFFFF;
        --tinta: #231F20;
        --niebla: #E1E2E1;
        --gris: #55575B;
        --gris-medio: #939598;
        --marino: #0D0B70;
        --senal: #0034D9;
        --azul-claro: #E6ECFB;
        --cabecera: rgba(244, 245, 244, 0.82);
        --pildora-activa: rgba(0, 52, 217, 0.08);
        --pildora-borde: rgba(0, 52, 217, 0.28);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        transition: background 200ms ease, color 200ms ease;
        background: var(--papel);
        color: var(--tinta);
        font-family: var(--cuerpo);
        font-size: 1.1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .marco { max-width: var(--ancho); margin: 0 auto; padding: 0 1.5rem; }

      h1, h2, h3 { font-family: var(--display); font-weight: 700; line-height: 1.14; letter-spacing: -0.015em; margin: 0; }
      h1 { font-size: clamp(2.3rem, 5vw, 3.5rem); }
      h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
      h3 { font-size: 1.3rem; }

      a { color: var(--senal); text-underline-offset: 0.18em; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--senal); outline-offset: 3px; }

      /* Procedencia: el sistema que distingue a este sitio */
      .procedencia {
        font-family: var(--dato);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.22rem 0.5rem;
        border: 1px solid currentColor;
      }
      .procedencia[data-tipo='propio'] { background: var(--fen); color: #fff; border-color: var(--fen); }
      .procedencia[data-tipo='colaboracion'] { color: var(--tinta); border-width: 2px; }
      .procedencia[data-tipo='comentada'] { color: var(--senal); background: var(--azul-claro); border-color: var(--senal); }
      .procedencia[data-tipo='sugerencia'] { color: var(--gris); border-style: dashed; }

      /* Cabecera fija con fondo translucido, al estilo de la version de David */
      .sitio-cabecera {
        position: sticky; top: 0; z-index: 50;
        background: var(--cabecera);
        -webkit-backdrop-filter: saturate(160%) blur(14px);
        backdrop-filter: saturate(160%) blur(14px);
        border-bottom: 1px solid var(--niebla);
      }
      .sitio-cabecera::before {
        content: ''; display: block; height: 3px;
        background: linear-gradient(90deg, var(--fen) 0 60%, var(--fen-claro));
      }
      .cabecera-fila { display: flex; align-items: center; gap: 1.2rem; padding-block: 0.7rem; max-width: 1400px; }
      .identidad { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; min-width: 0; }
      .logos { display: flex; align-items: center; gap: 0.5rem; }
      .logos img { display: block; height: 38px; width: auto; border-radius: 4px; }
      .marca { font-family: var(--display); font-weight: 700; font-size: 0.98rem; line-height: 1.2; letter-spacing: -0.01em; color: var(--tinta); }
      .marca span { display: block; font-family: var(--dato); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gris); margin-top: 0.15rem; }

      .menu { display: flex; gap: 0.25rem; margin-left: auto; overflow-x: auto; scrollbar-width: none; }
      .menu::-webkit-scrollbar { display: none; }
      .menu a {
        font-family: var(--dato); font-size: 0.88rem; font-weight: 500; white-space: nowrap;
        color: var(--gris); text-decoration: none;
        padding: 0.42rem 0.85rem; border-radius: 999px; border: 1px solid transparent;
      }
      .menu a:hover { color: var(--tinta); }
      .menu a[aria-current='page'] { color: var(--senal); background: var(--pildora-activa); border-color: var(--pildora-borde); }

      .controles { display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
      .control {
        display: inline-flex; align-items: center; justify-content: center;
        height: 34px; min-width: 34px; padding: 0 0.55rem;
        border-radius: 8px; border: 1px solid var(--niebla); background: var(--superficie);
        color: var(--gris); font-family: var(--dato); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em;
        text-decoration: none; cursor: pointer;
      }
      .control:hover { color: var(--tinta); border-color: var(--gris-medio); }
      .control svg { width: 16px; height: 16px; }
      .control .sol { display: none; }
      :root[data-tema='oscuro'] .control .sol, :root:not([data-tema]) .control .sol { display: block; }
      :root[data-tema='oscuro'] .control .luna { display: none; }
      .idioma { gap: 0.1rem; padding: 0 0.2rem; cursor: default; }
      .idioma a { color: var(--gris-medio); text-decoration: none; padding: 0.15rem 0.3rem; border-radius: 5px; }
      .idioma a:hover { color: var(--tinta); }
      .idioma a[aria-current='true'] { color: var(--tinta); font-weight: 700; background: var(--pildora-activa); }

      @media (max-width: 1340px) {
        .marca span { display: none; }
      }
      @media (max-width: 1120px) {
        .cabecera-fila { flex-wrap: wrap; row-gap: 0.5rem; }
        .menu { order: 3; width: 100%; margin-left: 0; padding-bottom: 0.15rem; }
        .controles { margin-left: auto; }
      }
      @media (max-width: 520px) {
        .cabecera-fila { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.5rem 0.6rem; }
        .menu { grid-column: 1 / -1; }
        .marca { white-space: normal; }
        .marca { font-size: 0.84rem; }
        .logos img { height: 32px; }
        .menu a { padding: 0.38rem 0.7rem; font-size: 0.84rem; }
      }

      .aviso-previa, .aviso-borrador { font-family: var(--dato); font-size: 0.8rem; text-align: center; padding: 0.45rem 1rem; }
      .aviso-previa { background: #F5B731; color: #231F20; font-weight: 600; }
      .aviso-borrador { background: var(--alerta); color: #fff; font-weight: 600; letter-spacing: 0.02em; }
      main { padding: 3.5rem 0 5rem; }
      main.portada { padding: 0; }


      .sitio-pie { border-top: 3px solid var(--fen); padding: 1.6rem 0; font-size: 1rem; color: var(--gris); }
      .areas-pie { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; padding-bottom: 1.1rem; margin-bottom: 1.1rem; border-bottom: 1px solid var(--niebla); font-family: var(--dato); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
      .areas-pie span { color: var(--tinta); }
      .areas-pie a { color: var(--gris); text-decoration: none; }
      .areas-pie a:hover { color: var(--senal); text-decoration: underline; }
      .sitio-pie .pie { display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; justify-content: space-between; }
      .sitio-pie .contacto { display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; padding-bottom: 1.1rem; margin-bottom: 1.1rem; border-bottom: 1px solid var(--niebla); font-family: var(--dato); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
      .sitio-pie .contacto span { color: var(--tinta); }
      .sitio-pie .contacto a { color: var(--senal); text-decoration: none; }
      .sitio-pie .contacto a:hover { text-decoration: underline; }
      .sitio-pie p { margin: 0; }

      @media (prefers-reduced-motion: no-preference) {
        a, .procedencia, .control { transition: color 120ms ease, background 120ms ease, border-color 120ms ease; }
      }
    </style>
  </head>
  <body>
    <header class="sitio-cabecera">
      <div class="marco cabecera-fila">
        <a class="identidad" href={ruta(idioma, '/')}>
          {logos.length > 0 && (
            <span class="logos">
              {logos.map((l) => <img src={`/logos/${l.archivo}`} alt={l.alt} height="38" />)}
            </span>
          )}
          <span class="marca">
            {t(idioma, 'sitio.nombreCorto')}
            <span>{t(idioma, 'sitio.institucion')}</span>
          </span>
        </a>
        <nav class="menu" aria-label={t(idioma, 'menu.principal')}>
          {menu.map((item) => (
            <a href={ruta(idioma, item.href)} aria-current={activo(item) ? 'page' : undefined}>
              {t(idioma, item.clave)}
            </a>
          ))}
        </nav>
        <div class="controles">
          <button class="control tema" type="button" id="cambiar-tema"
            data-claro={t(idioma, 'tema.claro')} data-oscuro={t(idioma, 'tema.oscuro')}
            aria-label={t(idioma, 'tema.claro')}>
            <svg class="sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <nav class="control idioma" aria-label={t(idioma, 'idioma.cambiar')}>
            {otros.map((o) => (
              <a href={o.href} hreflang={o.codigo} lang={o.codigo} title={o.nombre} aria-current={o.codigo === idioma ? 'true' : undefined}>
                {o.codigo.toUpperCase()}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    {esVistaPrevia && (
      <div class="aviso-previa" role="note">
        Vista previa{ramaActual ? ` de la rama ${ramaActual}` : ''}: incluye borradores que aún no están publicados.
      </div>
    )}
    {borrador && <div class="aviso-borrador" role="note">Borrador · esta pieza no se ve en el sitio publicado hasta que se apruebe.</div>}

    <main class={portada ? 'portada' : ''}><slot /></main>

    <footer class="sitio-pie">
      <div class="marco">
        <nav class="areas-pie" aria-label={t(idioma, 'pie.areas')}>
          <span>{t(idioma, 'pie.areas')}</span>
          {areas.map((a) => <a href={`/areas/${a.data.slug}/`}>{a.data.titulo}</a>)}
        </nav>
        <nav class="contacto" aria-label={t(idioma, 'pie.contacto')}>
          <span>{t(idioma, 'pie.contacto')}</span>
          <a href={linkedin} rel="noopener">LinkedIn</a>
        </nav>
        <div class="pie">
          <p>
            {t(idioma, 'pie.procedencia')} <a href={ruta(idioma, '/metodo/')}>{t(idioma, 'pie.metodo')}</a>
          </p>
          <p class="derechos">© {anio} · {t(idioma, 'pie.derechos')}</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        const boton = document.getElementById('cambiar-tema');
        if (!boton) return;
        const raiz = document.documentElement;
        const rotular = () => {
          const oscuro = raiz.dataset.tema !== 'claro';
          boton.setAttribute('aria-label', oscuro ? boton.dataset.claro : boton.dataset.oscuro);
          boton.title = boton.getAttribute('aria-label');
        };
        rotular();
        boton.addEventListener('click', () => {
          raiz.dataset.tema = raiz.dataset.tema === 'claro' ? 'oscuro' : 'claro';
          try { localStorage.setItem('observatorio-tema', raiz.dataset.tema); } catch (e) {}
          rotular();
        });
      })();
    </script>
  </body>
</html>

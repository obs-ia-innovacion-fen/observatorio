---
import fs from 'node:fs';
import { load as cargarYaml } from 'js-yaml';
import Base from '../layouts/Base.astro';

const archivo = fs.readFileSync('./datos/indicadores.yml', 'utf-8');
const { indicadores = [] } = cargarYaml(archivo) ?? {};

const hoy = new Date();
const unAnio = 365 * 24 * 60 * 60 * 1000;

const conEstado = indicadores.map((i) => {
  const verificado = i.verificado ? new Date(i.verificado) : null;
  return { ...i, vencido: verificado ? hoy - verificado > unAnio : true };
});

const fuentes = [...new Set(conEstado.map((i) => i.fuente))];
---

<Base
  titulo="Datos"
  descripcion="Indicadores de inteligencia artificial e innovación en Chile, Brasil, Argentina y América Latina, con fuente y fecha de verificación."
>
  <div class="marco">
    <p class="antetitulo">Datos</p>
    <h1>Indicadores de IA e innovación</h1>
    <p class="bajada">
      Cifras de referencia sobre la región. Cada una indica su fuente, el año al
      que corresponde y cuándo fue verificada por última vez. Si algún dato lleva
      más de un año sin revisar, aparece marcado.
    </p>

    <div class="rejilla">
      {conEstado.map((i) => (
        <article class="dato">
          <p class="cifra">{i.titulo}</p>
          <p class="detalle">{i.detalle}</p>
          <p class="origen">
            <a href={i.enlace} rel="noopener">{i.fuente}</a> · {i.anio}
            {i.vencido && <span class="vencido">verificar</span>}
          </p>
        </article>
      ))}
    </div>

    <section class="fuentes">
      <h2>Fuentes</h2>
      <ul>{fuentes.map((f) => <li>{f}</li>)}</ul>
      <p class="nota">
        Estamos incorporando el AI Index de Stanford y las encuestas nacionales
        de innovación de Brasil, Argentina y Chile. Compararlas exige una nota
        metodológica: los tres instrumentos miden cosas parecidas de maneras
        distintas, y ese trabajo todavía no está hecho.
      </p>
    </section>
  </div>
</Base>

<style>
  .antetitulo { font-family: var(--dato); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gris); margin: 0 0 1rem; }
  .bajada { max-width: 60ch; color: var(--gris); margin: 1.2rem 0 2.8rem; }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
  .dato { border-top: 3px solid var(--senal); padding: 1.1rem 0 0; }
  .cifra { font-family: var(--display); font-weight: 600; font-size: 2.1rem; line-height: 1; margin: 0; color: var(--tinta); }
  .detalle { font-size: 0.98rem; margin: 0.8rem 0 1rem; max-width: 34ch; }
  .origen { font-family: var(--dato); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gris); margin: 0; }
  .vencido { background: #f6e6c8; color: var(--alerta); padding: 0.1rem 0.4rem; margin-left: 0.5rem; }
  .fuentes { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--niebla); }
  .fuentes ul { font-family: var(--dato); font-size: 0.85rem; color: var(--gris); padding-left: 1.1rem; }
  .nota { max-width: 60ch; color: var(--gris); font-size: 0.95rem; }
</style>

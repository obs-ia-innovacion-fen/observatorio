---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pieza from '../../components/Pieza.astro';

const publicaciones = await getCollection('publicaciones');
const areas = (await getCollection('areas')).sort((a, b) => a.data.orden - b.data.orden);
---

<Base titulo="Publicaciones" descripcion="Producción del Observatorio y lecturas comentadas de la literatura académica y profesional, organizadas por área de trabajo.">
  <div class="marco">
    <p class="antetitulo">Investigación y análisis</p>
    <h1>Publicaciones</h1>
    <p class="bajada">
      Producción del Observatorio y lecturas comentadas de la literatura
      académica y profesional, organizadas por área de trabajo. Cada pieza
      declara su procedencia, ya sea investigación propia, trabajo en
      colaboración, comentario de un texto ajeno o sugerencia de lectura, de
      modo que el lector sepa desde el inicio qué tipo de aporte tiene delante.
    </p>

    {areas.map((area) => {
      const delArea = publicaciones.filter((p) => p.data.area === area.data.slug);
      return delArea.length > 0 ? (
        <section class="grupo">
          <h2><a href={`/areas/${area.data.slug}/`}>{area.data.titulo}</a></h2>
          {delArea.map((pieza) => <Pieza pieza={pieza} />)}
        </section>
      ) : null;
    })}
  </div>
</Base>

<style>
  .antetitulo { font-family: var(--dato); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gris); margin: 0 0 1rem; }
  .bajada { max-width: 58ch; color: var(--gris); margin: 1.2rem 0 3rem; }
  .grupo { margin-bottom: 3.5rem; }
  .grupo h2 a { color: var(--tinta); text-decoration: none; }
  .grupo h2 a:hover { color: var(--senal); }
</style>

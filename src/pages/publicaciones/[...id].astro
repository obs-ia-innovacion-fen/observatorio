---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Procedencia from '../../components/Procedencia.astro';

export async function getStaticPaths() {
  const publicaciones = await getCollection('publicaciones');
  return publicaciones.map((pieza) => ({ params: { id: pieza.id }, props: { pieza } }));
}

const { pieza } = Astro.props;
const d = pieza.data;
const { Content } = await render(pieza);
const areas = await getCollection('areas');
const area = areas.find((a) => a.data.slug === d.area);
---

<Base titulo={d.titulo} descripcion={d.publicado_en ?? 'Publicación del Observatorio'}>
  <article class="marco ficha">
    <div class="meta">
      <Procedencia tipo={d.tipo} revisado={d.revisado_por_pares} fuente={d.fuente_ficha} />
    </div>

    <h1>{d.titulo}</h1>

    <p class="atribucion">
      {d.autores.length > 0 && <span>{d.autores.join(', ')}</span>}
      {d.publicado_en && <span> · {d.publicado_en}</span>}
      {d.anio && <span> · {d.anio}</span>}
      {d.institucion && <span> · {d.institucion}</span>}
    </p>

    {area && <p class="area-enlace"><a href={`/areas/${area.data.slug}/`}>{area.data.titulo}</a></p>}

    <div class="prosa"><Content /></div>

    {d.enlace && (
      <p class="original">
        Artículo original: <a href={d.enlace} rel="noopener">{d.enlace}</a>
      </p>
    )}
  </article>
</Base>

<style>
  .ficha { max-width: 820px; }
  .meta { margin-bottom: 1.2rem; }
  .ficha h1 { font-size: clamp(1.7rem, 3.6vw, 2.5rem); max-width: 26ch; }
  .atribucion { font-family: var(--dato); font-size: 0.82rem; color: var(--gris); margin: 1.2rem 0 0.4rem; line-height: 1.6; }
  .area-enlace { font-family: var(--dato); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 2.4rem; }
  .prosa { max-width: var(--medida); }
  .prosa :global(h2) { margin: 2.4rem 0 0.7rem; font-size: 1.3rem; }
  .prosa :global(p) { margin: 0 0 1.2rem; }
  .prosa :global(pre) { background: #fff; border: 1px solid var(--niebla); padding: 1rem; overflow-x: auto; font-size: 0.85rem; }
  .original { margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--niebla); font-size: 0.92rem; word-break: break-all; }
</style>

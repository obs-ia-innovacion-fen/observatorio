---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Suscripcion from '../../components/Suscripcion.astro';

export async function getStaticPaths() {
  let webinars = [];
  try { webinars = await getCollection('webinars'); } catch { webinars = []; }
  return webinars.map((w) => ({ params: { id: w.id }, props: { w } }));
}

const { w } = Astro.props;
const { Content } = await render(w);
---

<Base titulo={w.data.titulo} descripcion="Nota del webinar del Observatorio de IA e Innovación en los Negocios.">
  <article class="marco nota">
    <p class="antetitulo">
      <a href="/webinars/">Webinars</a> ·
      {new Date(w.data.fecha_evento).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })}
    </p>
    <h1>{w.data.titulo}</h1>

    {w.data.panelistas?.length > 0 && (
      <ul class="panel">
        {w.data.panelistas.map((p) => <li>{p}</li>)}
      </ul>
    )}

    <div class="prosa"><Content /></div>

    <Suscripcion />
  </article>
</Base>

<style>
  .nota { max-width: 820px; }
  .antetitulo { font-family: var(--dato); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gris); margin: 0 0 1rem; }
  .nota h1 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); max-width: 26ch; }
  .panel { list-style: none; padding: 0; margin: 1.6rem 0 2.4rem; font-family: var(--dato); font-size: 0.78rem; color: var(--gris); }
  .panel li { padding: 0.3rem 0; }
  .prosa { max-width: var(--medida); }
  .prosa :global(h2) { margin: 2.4rem 0 0.8rem; font-size: 1.25rem; }
  .prosa :global(p) { margin: 0 0 1.2rem; }
  .prosa :global(strong) { color: var(--tinta); }
</style>

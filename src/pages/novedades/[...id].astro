---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Suscripcion from '../../components/Suscripcion.astro';

export async function getStaticPaths() {
  let notas = [];
  try { notas = await getCollection('vigilancia'); } catch { notas = []; }
  return notas.map((n) => ({ params: { id: n.id }, props: { n } }));
}

const { n } = Astro.props;
const { Content } = await render(n);
const areas = await getCollection('areas');
const area = areas.find((a) => a.data.slug === n.data.area);
---

<Base titulo={n.data.titulo} descripcion="Nota de vigilancia del Observatorio de IA e Innovación en los Negocios.">
  <article class="marco nota">
    <p class="antetitulo">
      <a href="/novedades/">Novedades</a> ·
      {new Date(n.data.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })}
      {area && <> · <a href={`/areas/${area.data.slug}/`}>{area.data.titulo}</a></>}
    </p>
    <h1>{n.data.titulo}</h1>

    <div class="prosa"><Content /></div>

    {n.data.fuentes?.length > 0 && (
      <section class="fuentes">
        <h2>Enlaces</h2>
        <ul>{n.data.fuentes.map((f) => <li><a href={f} rel="noopener">{f}</a></li>)}</ul>
      </section>
    )}

    <Suscripcion />
  </article>
</Base>

<style>
  .nota { max-width: 820px; }
  .antetitulo { font-family: var(--dato); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gris); margin: 0 0 1rem; }
  .nota h1 { font-size: clamp(1.55rem, 3.2vw, 2.2rem); max-width: 28ch; }
  .prosa { max-width: var(--medida); margin-top: 2rem; }
  .prosa :global(h2) { margin: 2.3rem 0 0.8rem; font-size: 1.2rem; }
  .prosa :global(p) { margin: 0 0 1.2rem; }
  .fuentes { margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--niebla); }
  .fuentes h2 { font-size: 1rem; font-family: var(--dato); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500; }
  .fuentes ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .fuentes li { padding: 0.4rem 0; font-size: 0.85rem; word-break: break-all; }
</style>

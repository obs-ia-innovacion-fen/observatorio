---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pieza from '../../components/Pieza.astro';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((area) => ({ params: { slug: area.data.slug }, props: { area } }));
}

const { area } = Astro.props;
const { Content } = await render(area);
const publicaciones = (await getCollection('publicaciones')).filter(
  (p) => p.data.area === area.data.slug
);

const orden = { propio: 0, colaboracion: 1, comentada: 2, sugerencia: 3 };
const ordenadas = publicaciones.sort(
  (a, b) => (orden[a.data.tipo] ?? 9) - (orden[b.data.tipo] ?? 9)
);
---

<Base titulo={area.data.titulo} descripcion={area.data.descripcion}>
  <article class="marco area">
    <p class="antetitulo">Área</p>
    <h1>{area.data.titulo}</h1>
    <p class="bajada">{area.data.descripcion}</p>

    <div class="prosa"><Content /></div>

    {area.data.alcance && (
      <aside class="alcance">
        <h2>Alcance</h2>
        <p>{area.data.alcance}</p>
      </aside>
    )}

    <section class="listado">
      <h2>Publicaciones de esta área</h2>
      {ordenadas.length === 0 ? (
        <p class="vacio">Todavía no hay publicaciones en esta área.</p>
      ) : (
        ordenadas.map((pieza) => <Pieza pieza={pieza} />)
      )}
    </section>
  </article>
</Base>

<style>
  .area { max-width: 820px; }
  .antetitulo {
    font-family: var(--dato); font-size: 0.74rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--gris); margin: 0 0 1rem;
  }
  .bajada { font-size: 1.12rem; color: var(--gris); max-width: var(--medida); margin: 1.2rem 0 2.5rem; }
  .prosa { max-width: var(--medida); }
  .prosa :global(h2) { margin: 2.2rem 0 0.8rem; }
  .prosa :global(p) { margin: 0 0 1.2rem; }
  .alcance { border-left: 3px solid var(--niebla); padding: 0.2rem 0 0.2rem 1.4rem; margin: 2.5rem 0; border-radius: 0; }
  .alcance h2 { font-size: 1rem; font-family: var(--dato); text-transform: uppercase; letter-spacing: 0.09em; font-weight: 500; }
  .alcance p { color: var(--gris); font-size: 0.98rem; margin: 0.6rem 0 0; }
  .listado { margin-top: 3rem; padding-top: 1rem; border-top: 2px solid var(--tinta); }
  .vacio { color: var(--gris); font-style: italic; }
</style>

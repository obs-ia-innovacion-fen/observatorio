---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pieza from '../../components/Pieza.astro';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((area) => ({ params: { slug: area.data.slug }, props: { area } }));
}

const { area } = Astro.props;

const publicaciones = (await getCollection('publicaciones')).filter(
  (p) => p.data.area === area.data.slug
);
const orden = { propio: 0, colaboracion: 1, comentada: 2, sugerencia: 3 };
const ordenadas = publicaciones.sort(
  (a, b) => (orden[a.data.tipo] ?? 9) - (orden[b.data.tipo] ?? 9)
);

let notas = [];
try {
  notas = (await getCollection('vigilancia'))
    .filter((n) => n.data.area === area.data.slug)
    .sort((a, b) => new Date(b.data.fecha) - new Date(a.data.fecha));
} catch { notas = []; }
---

<Base titulo={area.data.titulo} descripcion={area.data.descripcion}>
  <div class="marco area">
    <p class="antetitulo">Área</p>
    <h1>{area.data.titulo}</h1>

    <p class="sintesis">{area.data.sintesis ?? area.data.descripcion}</p>
    <a class="mas" href={`/areas/${area.data.slug}/sobre/`}>
      Cómo entendemos esta área
    </a>

    <section class="listado">
      <h2>Publicaciones seleccionadas</h2>
      {ordenadas.length === 0 ? (
        <p class="vacio">Todavía no hay publicaciones en esta área.</p>
      ) : (
        ordenadas.map((pieza) => <Pieza pieza={pieza} />)
      )}
    </section>

    {notas.length > 0 && (
      <section class="novedades">
        <h2>Novedades de esta área</h2>
        {notas.map((n) => (
          <article class="nota">
            <p class="fecha">
              {new Date(n.data.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
            <h3><a href={`/novedades/${n.id}/`}>{n.data.titulo}</a></h3>
          </article>
        ))}
      </section>
    )}
  </div>
</Base>

<style>
  .area { max-width: 820px; }
  .antetitulo { font-family: var(--dato); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gris); margin: 0 0 1rem; }
  .sintesis { font-size: 1.1rem; max-width: 58ch; margin: 1.2rem 0 1.2rem; }
  .mas { display: inline-block; font-family: var(--dato); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .listado { margin-top: 3rem; padding-top: 1rem; border-top: 2px solid var(--tinta); }
  .listado h2, .novedades h2 { font-size: 1.15rem; }
  .vacio { color: var(--gris); font-style: italic; }
  .novedades { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--niebla); }
  .nota { padding: 1.2rem 0; border-bottom: 1px solid var(--niebla); }
  .fecha { font-family: var(--dato); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--gris); margin: 0 0 0.4rem; }
  .nota h3 { font-size: 1.05rem; }
  .nota h3 a { color: var(--tinta); text-decoration: none; }
  .nota h3 a:hover { color: var(--senal); }
</style>

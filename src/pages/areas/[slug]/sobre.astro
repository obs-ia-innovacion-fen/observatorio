---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((area) => ({ params: { slug: area.data.slug }, props: { area } }));
}

const { area } = Astro.props;
const { Content } = await render(area);
---

<Base titulo={`Sobre ${area.data.titulo}`} descripcion={area.data.descripcion}>
  <article class="marco sobre">
    <p class="antetitulo">
      <a href={`/areas/${area.data.slug}/`}>{area.data.titulo}</a> · Cómo la entendemos
    </p>
    <h1>{area.data.titulo}</h1>
    <p class="bajada">{area.data.descripcion}</p>

    <div class="prosa"><Content /></div>

    {area.data.alcance && (
      <aside class="alcance">
        <h2>Alcance</h2>
        <p>{area.data.alcance}</p>
      </aside>
    )}

    <a class="volver" href={`/areas/${area.data.slug}/`}>Ver las publicaciones del área</a>
  </article>
</Base>

<style>
  .sobre { max-width: 820px; }
  .antetitulo { font-family: var(--dato); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gris); margin: 0 0 1rem; }
  .bajada { font-size: 1.08rem; color: var(--gris); max-width: var(--medida); margin: 1.1rem 0 2.4rem; }
  .prosa { max-width: var(--medida); }
  .prosa :global(h2) { margin: 2.2rem 0 0.8rem; font-size: 1.2rem; }
  .prosa :global(p) { margin: 0 0 1.2rem; }
  .alcance { border-left: 3px solid var(--niebla); padding-left: 1.4rem; margin: 2.5rem 0; }
  .alcance h2 { font-size: 0.95rem; font-family: var(--dato); text-transform: uppercase; letter-spacing: 0.09em; font-weight: 500; }
  .alcance p { color: var(--gris); font-size: 0.96rem; margin: 0.6rem 0 0; }
  .volver { display: inline-block; margin-top: 2rem; font-family: var(--dato); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em; }
</style>

---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Pieza from '../components/Pieza.astro';
import Suscripcion from '../components/Suscripcion.astro';

const areas = (await getCollection('areas')).sort((a, b) => a.data.orden - b.data.orden);
const publicaciones = await getCollection('publicaciones');

// Lectura del propio instrumento: se calcula desde la bandeja real del repositorio.
const dirBandeja = path.resolve('./fuentes/bandeja');
let ultimaRecoleccion = null;
let registrosEnBandeja = 0;

if (fs.existsSync(dirBandeja)) {
  const archivos = fs.readdirSync(dirBandeja).filter((f) => f.endsWith('.json'));
  const fechas = archivos.map((f) => f.slice(0, 10)).filter((f) => /^\d{4}-\d{2}-\d{2}$/.test(f));
  ultimaRecoleccion = fechas.sort().at(-1) ?? null;
  for (const archivo of archivos.filter((f) => f.startsWith(ultimaRecoleccion ?? ''))) {
    try {
      const datos = JSON.parse(fs.readFileSync(path.join(dirBandeja, archivo), 'utf-8'));
      if (Array.isArray(datos)) registrosEnBandeja += datos.length;
    } catch { /* archivo ilegible: se ignora en el conteo */ }
  }
}

const fechaLegible = ultimaRecoleccion
  ? new Date(ultimaRecoleccion + 'T12:00:00').toLocaleDateString('es-CL', {
      day: 'numeric', month: 'long', year: 'numeric',
    })
  : null;

const recientes = publicaciones
  .sort((a, b) => (b.data.anio ?? 0) - (a.data.anio ?? 0))
  .slice(0, 6);
---

<Base
  titulo="Inicio"
  descripcion="Observatorio de IA e Innovación en los Negocios. Evidencia sobre inteligencia artificial e innovación empresarial en Chile, Brasil y Argentina."
>
  <section class="marco portada">
    <p class="antetitulo">Cobertura global · Lectura regional</p>
    <h1>Evidencia sobre IA e innovación en los negocios</h1>
    <p class="bajada">
      Seguimos la frontera del conocimiento en inteligencia artificial e
      innovación y su uso práctico: en ecosistemas locales, nacionales y
      regionales, en innovación de triple impacto, y sobre todo en las empresas
      de menor tamaño. Publicamos poco, y cada pieza declara de dónde viene.
    </p>

    <div class="instrumento">
      <p class="instrumento-titulo">
        En la revisión del {fechaLegible ?? 'periodo en curso'} examinamos
        <strong>{registrosEnBandeja || '—'}</strong> trabajos y publicamos
        <strong>{publicaciones.length}</strong>.
      </p>
      <p class="instrumento-nota">
        La distancia entre ambas cifras es el trabajo del Observatorio: la mayor
        parte de lo que se revisa no supera el criterio editorial. Cómo se
        decide está explicado en <a href="/metodo/">el método</a>.
      </p>
    </div>
  </section>

  <section class="marco areas" id="areas">
    <h2>Áreas</h2>
    <div class="rejilla">
      {areas.map((area) => (
        <a class="area" href={`/areas/${area.data.slug}/`}>
          <h3>{area.data.titulo}</h3>
          <p>{area.data.descripcion}</p>
          <span class="ir">Ver el área</span>
        </a>
      ))}
    </div>
  </section>

  {recientes.length > 0 && (
    <section class="marco ultimas">
      <h2>Lo último</h2>
      {recientes.map((pieza) => <Pieza pieza={pieza} />)}
    </section>
  )}

  <div class="marco"><Suscripcion /></div>
</Base>

<style>
  .portada { max-width: 900px; padding-bottom: 3.5rem; }
  .antetitulo {
    font-family: var(--dato); font-size: 0.74rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--gris); margin: 0 0 1.1rem;
  }
  .portada h1 { max-width: 20ch; }
  .bajada { max-width: 58ch; font-size: 1.16rem; margin: 1.5rem 0 2.6rem; }

  .instrumento { border-left: 4px solid var(--senal); padding: 0.4rem 0 0.4rem 1.5rem; margin: 0; }
  .instrumento-titulo { font-family: var(--display); font-size: 1.28rem; line-height: 1.4; margin: 0; max-width: 44ch; }
  .instrumento-titulo strong { color: var(--senal); font-weight: 600; }
  .instrumento-nota { font-size: 0.95rem; color: var(--gris); max-width: 54ch; margin: 0.9rem 0 0; }

  .areas { padding: 3.5rem 0; border-top: 1px solid var(--niebla); }
  .rejilla {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem; margin-top: 1.8rem;
  }
  .area {
    display: block; padding: 1.5rem; border: 1px solid var(--niebla);
    text-decoration: none; color: var(--tinta); background: #fff;
  }
  .area:hover { border-color: var(--senal); box-shadow: inset 4px 0 0 var(--senal); }
  .area p { font-size: 0.98rem; color: var(--gris); margin: 0.7rem 0 1.1rem; }
  .ir {
    font-family: var(--dato); font-size: 0.72rem; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--senal);
  }

  .ultimas { padding-top: 1rem; }
  .ultimas h2 { margin-bottom: 0.6rem; }
</style>

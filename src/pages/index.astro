---
import fs from 'node:fs';
import { load as cargarYaml } from 'js-yaml';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Procedencia from '../components/Procedencia.astro';
import Suscripcion from '../components/Suscripcion.astro';

const areas = (await getCollection('areas')).sort((a, b) => a.data.orden - b.data.orden);

// Lo último: una publicación con análisis propio, una novedad y una actividad.
const orden = { propio: 0, colaboracion: 1, comentada: 2, sugerencia: 3 };
const publicaciones = (await getCollection('publicaciones'))
  .sort((a, b) => (orden[a.data.tipo] ?? 9) - (orden[b.data.tipo] ?? 9) || new Date(b.data.fecha) - new Date(a.data.fecha));
const destacada = publicaciones[0];

let novedad = null;
try {
  novedad = (await getCollection('vigilancia')).sort((a, b) => new Date(b.data.fecha) - new Date(a.data.fecha))[0] ?? null;
} catch { novedad = null; }

let webinar = null;
try {
  webinar = (await getCollection('webinars')).sort((a, b) => new Date(b.data.fecha_evento) - new Date(a.data.fecha_evento))[0] ?? null;
} catch { webinar = null; }

const { indicadores = [] } = cargarYaml(fs.readFileSync('./datos/indicadores.yml', 'utf-8')) ?? {};

// Proximas actividades, desde datos/agenda.yml. Si no hay, el bloque no aparece.
const { proximas = [] } = cargarYaml(fs.readFileSync('./datos/agenda.yml', 'utf-8')) ?? {};
const agenda = proximas.slice(0, 3);
const rotulosEstado = { 'confirmada': 'Confirmada', 'por-confirmar': 'Por confirmar', 'inscripcion-abierta': 'Inscripción abierta' };

// Ultima recoleccion de medios, para la linea del radar.
let radar = null;
try {
  const dirBandeja = './fuentes/bandeja';
  const ultimo = fs.readdirSync(dirBandeja).filter((f) => /^\d{4}-\d{2}-\d{2}-medios\.json$/.test(f)).sort().at(-1);
  if (ultimo) {
    const piezas = JSON.parse(fs.readFileSync(`${dirBandeja}/${ultimo}`, 'utf-8'));
    radar = { fecha: ultimo.slice(0, 10), titulares: piezas.length, medios: new Set(piezas.map((p) => p.medio)).size };
  }
} catch { radar = null; }
const cifra = indicadores.find((i) => i.clave === 'inversion-global') ?? indicadores[0] ?? null;

const fecha = (f) => new Date(f).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  portada={true}
  titulo="Inicio"
  descripcion="Observatorio de IA e Innovación en los Negocios, FEN Universidad de Chile. Qué se está descubriendo sobre IA e innovación, y qué de eso sirve realmente a una empresa de la región."
>
  <section class="hero">
    <div class="marco entrada">
      <div class="presentacion">
        <p class="antetitulo">Observatorio · FEN · Universidad de Chile</p>
        <h1>
          Qué se está descubriendo sobre IA e innovación, y qué de eso sirve
          realmente a una empresa de la región.
        </h1>
        <p class="explicacion">
          Seguimos la investigación de punta, evaluamos qué funciona en la
          práctica y lo miramos donde importa: ecosistemas locales y regionales,
          innovación de triple impacto y empresas de menor tamaño. Publicamos
          poco, y cada pieza declara de dónde viene.
        </p>
        <div class="atajos">
          <a class="boton" href="/publicaciones/">Ver publicaciones</a>
          <a class="enlace" href="/recursos/">Recursos para aprender</a>
          <a class="enlace" href="/metodo/">Cómo trabajamos</a>
        </div>
      </div>

      <nav class="areas" aria-label="Áreas de trabajo">
        <p class="rotulo">Áreas de trabajo</p>
        {areas.map((area, i) => (
          <a class="area" href={`/areas/${area.data.slug}/`}>
            <span class="numero">{String(i + 1).padStart(2, '0')}</span>
            <span class="nombre">{area.data.titulo}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  {(agenda.length > 0 || radar) && (
    <section class="marco vivo" aria-label="Agenda y radar">
      {agenda.length > 0 && (
        <div class="tarjeta agenda">
          <p class="rotulo">Próximas actividades</p>
          <ul>
            {agenda.map((a) => (
              <li>
                <p class="meta">
                  <span class="tipo">{a.tipo}</span>
                  <span class="estado" data-estado={a.estado}>{rotulosEstado[a.estado] ?? a.estado}</span>
                  {a.fecha && <span>{a.fecha}</span>}
                </p>
                <p class="titulo-actividad">{a.titulo}</p>
              </li>
            ))}
          </ul>
          <a class="enlace-tarjeta" href="/webinars/#agenda">Toda la agenda e inscripciones</a>
        </div>
      )}
      {radar && (
        <div class="tarjeta radar">
          <p class="rotulo">Selección semanal de noticias</p>
          <p class="radar-cifra">{radar.titulares}</p>
          <p class="radar-texto">
            titulares sobre IA e innovación de <strong>{radar.medios}</strong> medios de Chile,
            Argentina, Colombia, Brasil y el mundo, recolectados esta semana.
          </p>
          <a class="boton-radar" href="/radar/">Ver el radar de prensa</a>
        </div>
      )}
    </section>
  )}

  <section class="marco ultimo" aria-label="Lo último">
    {cifra && (
      <article class="bloque dato">
        <p class="rotulo">Dato de la región</p>
        <p class="cifra">{cifra.titulo}</p>
        <p class="texto">{cifra.detalle}</p>
        <p class="pie-bloque">{cifra.fuente} · {cifra.anio} · <a href="/datos/">Todos los indicadores</a></p>
      </article>
    )}
    {destacada && (
      <article class="bloque">
        <p class="rotulo">Última publicación</p>
        <div class="etiqueta"><Procedencia tipo={destacada.data.tipo} revisado={destacada.data.revisado_por_pares} /></div>
        <h2><a href={destacada.data.tipo === 'sugerencia' ? (destacada.data.enlace ?? destacada.data.doi) : `/publicaciones/${destacada.id}/`}>{destacada.data.titulo}</a></h2>
        <p class="pie-bloque">{destacada.data.publicado_en} · {destacada.data.anio}</p>
      </article>
    )}
    {(novedad || webinar) && (
      <article class="bloque">
        {novedad && (
          <>
            <p class="rotulo">Novedad</p>
            <h2><a href={`/novedades/${novedad.id}/`}>{novedad.data.titulo}</a></h2>
            <p class="pie-bloque">{fecha(novedad.data.fecha)}</p>
          </>
        )}
        {webinar && (
          <>
            <p class="rotulo espaciado">Webinar</p>
            <h2><a href={`/webinars/${webinar.id}/`}>{webinar.data.titulo}</a></h2>
            <p class="pie-bloque">{fecha(webinar.data.fecha_evento)}</p>
          </>
        )}
      </article>
    )}
  </section>

  <div class="marco cierre">
    <Suscripcion />
  </div>
</Base>

<style>
  .hero { background: var(--fen); color: #fff; }
  .entrada {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.7fr);
    gap: 4rem;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
  .antetitulo { font-family: var(--dato); font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: #C9D1F7; margin: 0 0 1.4rem; }
  .presentacion h1 { font-size: clamp(2.2rem, 4vw, 3.4rem); max-width: 22ch; color: #fff; }
  .explicacion { max-width: 52ch; font-size: 1.25rem; line-height: 1.55; margin: 1.8rem 0 2.2rem; color: #E6EAFB; }
  .atajos { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
  .boton {
    display: inline-block; background: #fff; color: var(--fen); text-decoration: none;
    font-family: var(--display); font-weight: 600; font-size: 1.05rem; padding: 0.85rem 1.5rem;
  }
  .boton:hover { background: var(--azul-claro); }
  .enlace { color: #fff; font-family: var(--dato); font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .areas { background: #fff; color: var(--tinta); padding: 1.6rem 1.8rem 0.6rem; border-top: 6px solid var(--fen-claro); }
  .rotulo {
    font-family: var(--dato); font-size: 0.8rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gris); margin: 0 0 0.8rem;
  }
  .area {
    display: flex; align-items: baseline; gap: 1rem;
    padding: 0.9rem 0; border-bottom: 1px solid var(--niebla);
    text-decoration: none; color: var(--tinta);
  }
  .area:last-child { border-bottom: 0; }
  .area:hover .nombre { color: var(--fen); text-decoration: underline; }
  .numero { font-family: var(--dato); font-size: 0.85rem; color: var(--fen); }
  .nombre { font-family: var(--display); font-weight: 600; font-size: 1.25rem; line-height: 1.25; }

  .ultimo { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem; padding-top: 3rem; padding-bottom: 1rem; }
  .bloque { border-top: 3px solid var(--fen); padding-top: 1.2rem; min-width: 0; }
  .bloque h2 { font-size: 1.35rem; line-height: 1.3; margin: 0.6rem 0 0; }
  .bloque h2 a { color: var(--tinta); text-decoration: none; }
  .bloque h2 a:hover { color: var(--fen); text-decoration: underline; }
  .etiqueta { margin-top: 0.2rem; }
  .cifra { font-family: var(--display); font-weight: 600; font-size: 3.2rem; line-height: 1; color: var(--fen); margin: 0.4rem 0 0.6rem; }
  .texto { margin: 0; max-width: 34ch; }
  .pie-bloque { font-family: var(--dato); font-size: 0.85rem; color: var(--gris); margin: 0.8rem 0 0; }
  .espaciado { margin-top: 2rem; }
  .cierre { padding-bottom: 4rem; }
  .vivo { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem; padding-top: 2.5rem; }
  .tarjeta { background: #fff; border-top: 4px solid var(--fen); padding: 1.6rem 1.8rem 1.8rem; display: flex; flex-direction: column; }
  .agenda ul { list-style: none; padding: 0; margin: 0.4rem 0 0; flex: 1; }
  .agenda li { padding: 0.9rem 0; border-top: 1px solid var(--niebla); }
  .agenda li:first-child { border-top: 0; padding-top: 0.2rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; align-items: center; font-family: var(--dato); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--gris); margin: 0 0 0.4rem; }
  .tipo { color: var(--fen); }
  .estado { padding: 0.1rem 0.45rem; border: 1px solid var(--niebla); }
  .estado[data-estado='inscripcion-abierta'] { background: var(--fen); color: #fff; border-color: var(--fen); }
  .titulo-actividad { font-family: var(--display); font-weight: 600; font-size: 1.2rem; line-height: 1.3; margin: 0; }
  .enlace-tarjeta { margin-top: 1.2rem; font-family: var(--dato); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .radar-cifra { font-family: var(--display); font-weight: 700; font-size: 3.4rem; line-height: 1; color: var(--fen); margin: 0.4rem 0 0.5rem; }
  .radar-texto { font-size: 1.05rem; line-height: 1.5; margin: 0 0 1.4rem; color: var(--gris); flex: 1; }
  .radar-texto strong { color: var(--tinta); font-weight: 600; }
  .boton-radar { align-self: flex-start; display: inline-block; background: var(--fen); color: #fff; text-decoration: none; font-family: var(--display); font-weight: 600; font-size: 1.05rem; padding: 0.85rem 1.5rem; }
  .boton-radar:hover { background: var(--tinta); }
  @media (max-width: 900px) { .vivo { grid-template-columns: 1fr; } }

  @media (max-width: 900px) {
    .entrada { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 3rem; padding-bottom: 3rem; }
    .ultimo { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>

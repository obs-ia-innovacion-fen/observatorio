---
// Portada: una vitrina del contenido. No explica qué es el Observatorio
// (eso vive en Nosotros); muestra lo más reciente de cada sección y lleva a
// la lista completa. Todo se arma solo desde contenido/ y fuentes/bandeja/.
import fs from 'node:fs';
import { load as cargarYaml } from 'js-yaml';
import { getCollection } from '../lib/contenido';
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Procedencia from '../components/Procedencia.astro';
import Suscripcion from '../components/Suscripcion.astro';
import { idiomaDe, t, ruta, locales } from '../i18n/ui';

const idioma = idiomaDe(Astro.url);
const local = locales[idioma];
const fecha = (f) => new Date(f).toLocaleDateString(local, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const fechaCorta = (f) => new Date(f).toLocaleDateString(local, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const seguro = async (nombre) => { try { return await getCollection(nombre); } catch { return []; } };

// Cada area tiene su variante de color para las portadas generadas.
const areas = await getCollection('areas');
const nombreArea = (slug) => areas.find((a) => a.data.slug === slug)?.data.titulo ?? '';
const variantes = { 'ia-en-pymes': 'a', innovacion: 'b', 'gobernanza-y-regulacion': 'c', 'ia-para-emprendedores': 'd' };
const variante = (slug) => variantes[slug] ?? 'a';

// Evento destacado: el webinar mas reciente con imagen; si ninguno tiene, el mas reciente.
const webinars = (await seguro('webinars')).sort((a, b) => b.data.fecha_evento - a.data.fecha_evento);
const evento = webinars.find((w) => w.data.imagen) ?? webinars[0] ?? null;

const { proximas = [] } = cargarYaml(fs.readFileSync('./datos/agenda.yml', 'utf-8')) ?? {};
const agenda = proximas.slice(0, 3);

const prensa = (await seguro('prensa')).sort((a, b) => b.data.fecha - a.data.fecha).slice(0, 3);
const notas = (await seguro('vigilancia')).sort((a, b) => b.data.fecha - a.data.fecha).slice(0, 2);
const podcasts = (await seguro('podcasts')).sort((a, b) => (b.data.numero ?? 0) - (a.data.numero ?? 0)).slice(0, 3);
const spotify = podcasts.find((p) => p.data.spotify)?.data.spotify ?? null;

// Investigacion: primero lo propio y lo comentado, luego lo marcado como
// destacado, luego las sugerencias.
const peso = { propio: 0, colaboracion: 1, comentada: 2, sugerencia: 3 };
const investigacion = (await seguro('publicaciones'))
  .sort((a, b) => (peso[a.data.tipo] ?? 9) - (peso[b.data.tipo] ?? 9)
    || Number(b.data.destacado) - Number(a.data.destacado)
    || (b.data.anio ?? 0) - (a.data.anio ?? 0))
  .slice(0, 3);

// Radar: titulares de la ultima recoleccion, priorizando medios de la region.
let radar = null;
try {
  const dir = './fuentes/bandeja';
  const ultimo = fs.readdirSync(dir).filter((f) => /^\d{4}-\d{2}-\d{2}-medios\.json$/.test(f)).sort().at(-1);
  if (ultimo) {
    const piezas = JSON.parse(fs.readFileSync(`${dir}/${ultimo}`, 'utf-8'))
      .filter((p) => p.nivel !== 'practica' && p.titulo && p.enlace)
      .sort((a, b) => new Date(b.fecha ?? 0) - new Date(a.fecha ?? 0));
    const pais = (m) => /\((CL|AR|CO|BR)\)\s*$/.exec(m ?? '')?.[1] ?? 'GL';
    const limpiar = (m) => (m ?? '').replace(/\s*\((CL|AR|CO|BR)\)\s*$/, '').split(' · ')[0];
    // Tres titulares de la region y tres del mundo, uno por medio.
    const elegir = (grupo) => {
      const medios = new Set();
      return grupo.filter((p) => {
        const m = limpiar(p.medio);
        if (medios.has(m)) return false;
        medios.add(m);
        return true;
      }).slice(0, 3);
    };
    const muestra = [
      ...elegir(piezas.filter((p) => pais(p.medio) !== 'GL')),
      ...elegir(piezas.filter((p) => pais(p.medio) === 'GL')),
    ].map((p) => ({ titulo: p.titulo, enlace: p.enlace, medio: limpiar(p.medio), pais: pais(p.medio) }));
    radar = { titulares: piezas.length, muestra: muestra.slice(0, 6) };
  }
} catch { radar = null; }

const { indicadores = [] } = cargarYaml(fs.readFileSync('./datos/indicadores.yml', 'utf-8')) ?? {};
const cifra = indicadores.find((i) => i.clave === 'inversion-global') ?? indicadores[0] ?? null;

const rotuloEstado = { confirmada: 'Confirmada', 'por-confirmar': t(idioma, 'inicio.porConfirmar'), 'inscripcion-abierta': 'Inscripción abierta' };
const resumen = (texto, n = 150) => {
  const limpio = (texto ?? '').replace(/^#+.*$/gm, '').replace(/[*_`>[\]]/g, '').replace(/\(http[^)]*\)/g, '').replace(/\s+/g, ' ').trim();
  return limpio.length > n ? `${limpio.slice(0, n).replace(/\s+\S*$/, '')}…` : limpio;
};
const anfitrion = (lista) => lista.map((p) => p.split(',')[0]).join(' · ');
---

<Base
  portada={true}
  titulo="Inicio"
  descripcion="Novedades, investigación, eventos y noticias sobre inteligencia artificial e innovación en los negocios, desde la Facultad de Economía y Negocios de la Universidad de Chile."
>
  <div class="vitrina">

    {(evento || agenda.length > 0) && (
      <section class="marco portada-grid" aria-label={t(idioma, 'inicio.destacado')}>
        {evento && (
          <a class="evento" href={`/webinars/${evento.id}/`}>
            <Portada imagen={evento.data.imagen} alt={evento.data.titulo} rotulo={evento.data.titulo} variante={variante(evento.data.area)} proporcion="16 / 9" carga="eager" />
            <div class="evento-texto">
              <p class="chip">{t(idioma, 'inicio.destacado')} · {fecha(evento.data.fecha_evento)}</p>
              <h1>{evento.data.titulo}</h1>
              {evento.data.panelistas.length > 0 && <p class="meta">{anfitrion(evento.data.panelistas)}</p>}
            </div>
          </a>
        )}

        <div class="lateral">
          {agenda.length > 0 && (
            <div class="caja">
              <p class="rotulo">{t(idioma, 'inicio.proximas')}</p>
              <ul class="agenda">
                {agenda.map((a) => (
                  <li>
                    <p class="meta"><span class="tipo">{a.tipo}</span> · {a.fecha ? fecha(a.fecha) : rotuloEstado[a.estado] ?? a.estado}</p>
                    <p class="titulo-agenda">{a.titulo}</p>
                  </li>
                ))}
              </ul>
              <a class="ver" href={ruta(idioma, '/webinars/')}>{t(idioma, 'inicio.agenda')} →</a>
            </div>
          )}
          {podcasts[0] && (
            <a class="episodio-mini" href={podcasts[0].data.youtube ?? podcasts[0].data.spotify}>
              <Portada imagen={podcasts[0].data.imagen} alt={podcasts[0].data.titulo} rotulo={podcasts[0].data.titulo} video={true} proporcion="16 / 9" />
              <div>
                <p class="rotulo">{t(idioma, 'inicio.podcast')} · {t(idioma, 'inicio.episodio')} {podcasts[0].data.numero}</p>
                <p class="titulo-agenda">{podcasts[0].data.titulo}</p>
              </div>
            </a>
          )}
        </div>
      </section>
    )}

    {prensa.length > 0 && (
      <section class="marco seccion" aria-labelledby="t-medios">
        <header class="cabeza">
          <h2 id="t-medios">{t(idioma, 'inicio.medios')}</h2>
          <a href={ruta(idioma, '/prensa/')}>{t(idioma, 'inicio.verTodo')} →</a>
        </header>
        <div class="tres">
          {prensa.map((p) => (
            <a class="tarjeta" href={p.data.enlace} rel="noopener">
              <Portada imagen={p.data.imagen} alt={p.data.titulo} rotulo={p.data.medio.split(',')[0]} variante={variante(p.data.area)} proporcion="16 / 9" video={/youtu/.test(p.data.enlace) && !!p.data.imagen} />
              <p class="meta"><span class="tipo">{p.data.medio.split(',')[0]}</span> · {fecha(p.data.fecha)}</p>
              <h3>{p.data.titulo}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="marco seccion" aria-labelledby="t-noticias">
      <header class="cabeza">
        <h2 id="t-noticias">{t(idioma, 'inicio.noticias')}</h2>
        <a href={ruta(idioma, '/novedades/')}>{t(idioma, 'inicio.verTodo')} →</a>
      </header>
      <div class="noticias">
        {notas.length > 0 && (
          <div class="analisis">
            {notas.map((n) => (
              <a class="tarjeta horizontal" href={`/novedades/${n.id}/`}>
                <Portada imagen={n.data.imagen} alt={n.data.titulo} rotulo={nombreArea(n.data.area)} variante={variante(n.data.area)} proporcion="4 / 3" />
                <div>
                  <p class="meta"><span class="tipo">{t(idioma, 'inicio.analisis')}</span> · {fecha(n.data.fecha)}</p>
                  <h3>{n.data.titulo}</h3>
                  <p class="bajada">{resumen(n.body)}</p>
                </div>
              </a>
            ))}
          </div>
        )}
        {radar && radar.muestra.length > 0 && (
          <div class="caja radar">
            <p class="rotulo">{t(idioma, 'inicio.radar')}</p>
            <ul>
              {radar.muestra.map((r) => (
                <li>
                  <p class="meta"><span class="pais">{r.pais === 'GL' ? 'INT' : r.pais}</span> {r.medio}</p>
                  <a href={r.enlace} rel="noopener">{r.titulo}</a>
                </li>
              ))}
            </ul>
            <a class="ver" href={ruta(idioma, '/radar/')}>{t(idioma, 'inicio.radarTodo').replace('{n}', String(radar.titulares))} →</a>
          </div>
        )}
      </div>
    </section>

    {investigacion.length > 0 && (
      <section class="marco seccion" aria-labelledby="t-investigacion">
        <header class="cabeza">
          <h2 id="t-investigacion">{t(idioma, 'inicio.investigacion')}</h2>
          <a href={ruta(idioma, '/publicaciones/')}>{t(idioma, 'inicio.verTodo')} →</a>
        </header>
        <div class="tres">
          {investigacion.map((p) => {
            const destino = p.data.tipo === 'sugerencia' ? (p.data.enlace ?? p.data.doi) : `/publicaciones/${p.id}/`;
            return (
              <a class="tarjeta paper" href={destino} data-variante={variante(p.data.area)}>
                <div class="etiquetas"><Procedencia tipo={p.data.tipo} /></div>
                <h3>{p.data.titulo}</h3>
                <p class="meta">{[p.data.publicado_en, p.data.anio].filter(Boolean).join(' · ')}</p>
                <p class="area">{nombreArea(p.data.area)}</p>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {podcasts.length > 0 && (
      <section class="marco seccion" aria-labelledby="t-podcast">
        <header class="cabeza">
          <h2 id="t-podcast">{t(idioma, 'inicio.podcast')}</h2>
          {spotify && <a href={spotify} rel="noopener">{t(idioma, 'inicio.spotify')} →</a>}
        </header>
        <div class="tres">
          {podcasts.map((p) => (
            <a class="tarjeta" href={p.data.youtube ?? p.data.spotify} rel="noopener">
              <Portada imagen={p.data.imagen} alt={p.data.titulo} rotulo={p.data.titulo} video={true} proporcion="16 / 9" />
              <p class="meta"><span class="tipo">{t(idioma, 'inicio.episodio')} {p.data.numero}</span> · {anfitrion(p.data.invitados)}</p>
              <h3>{p.data.titulo}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="marco seccion cierre">
      {cifra && (
        <a class="dato" href={ruta(idioma, '/datos/')}>
          <p class="rotulo">{t(idioma, 'inicio.dato')}</p>
          <p class="cifra">{cifra.titulo}</p>
          <p class="texto">{cifra.detalle}</p>
          <p class="meta">{cifra.fuente} · {cifra.anio} · {t(idioma, 'inicio.indicadores')} →</p>
        </a>
      )}
      <Suscripcion />
    </section>
  </div>
</Base>

<style>
  .vitrina { padding: 2rem 0 4.5rem; }
  .marco { max-width: 1240px; }

  .rotulo, .meta, .chip { font-family: var(--dato); }
  .rotulo { font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris); margin: 0 0 0.9rem; font-weight: 600; }
  .meta { font-size: 0.8rem; color: var(--gris); margin: 0.75rem 0 0.35rem; }
  .tipo { color: var(--senal); font-weight: 600; }
  a.tarjeta, .evento, .episodio-mini, .dato { text-decoration: none; color: var(--tinta); }
  h3 { font-size: 1.12rem; line-height: 1.3; letter-spacing: -0.01em; }
  a:hover h3, a:hover h1, a:hover .titulo-agenda { color: var(--senal); }

  /* Destacado */
  .portada-grid { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); gap: 1.5rem; }
  .evento { position: relative; display: block; border-radius: 14px; overflow: hidden; }
  .evento :global(.portada) { border-radius: 14px; aspect-ratio: auto !important; height: 100%; min-height: 420px; }
  .evento-texto {
    position: absolute; inset: auto 0 0 0; padding: 4.5rem 1.8rem 1.6rem;
    background: linear-gradient(to top, rgba(8, 14, 40, 0.94) 0%, rgba(8, 14, 40, 0.7) 55%, transparent 100%);
    color: #fff;
  }
  .chip { display: inline-block; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; background: var(--fen); color: #fff; padding: 0.3rem 0.65rem; border-radius: 999px; margin: 0 0 0.9rem; }
  .evento h1 { font-size: clamp(1.5rem, 2.8vw, 2.25rem); max-width: 26ch; color: #fff; }
  .evento .meta { color: rgba(255, 255, 255, 0.78); margin-top: 0.7rem; }
  a.evento:hover h1 { color: #fff; text-decoration: underline; text-decoration-thickness: 2px; }

  .lateral { display: flex; flex-direction: column; gap: 1.5rem; }
  .caja { background: var(--superficie); border: 1px solid var(--niebla); border-radius: 14px; padding: 1.4rem 1.5rem; }
  .agenda { list-style: none; margin: 0; padding: 0; }
  .agenda li { padding: 0.15rem 0 0.9rem; border-bottom: 1px solid var(--niebla); margin-bottom: 0.8rem; }
  .agenda li:last-child { border-bottom: 0; margin-bottom: 0.2rem; }
  .agenda .meta { margin-top: 0; }
  .titulo-agenda { font-family: var(--display); font-weight: 600; font-size: 1rem; line-height: 1.35; margin: 0; }
  .ver { font-family: var(--dato); font-size: 0.82rem; font-weight: 600; color: var(--senal); text-decoration: none; }
  .ver:hover { text-decoration: underline; }
  .episodio-mini { display: grid; grid-template-columns: 150px 1fr; gap: 1rem; align-items: center; background: var(--superficie); border: 1px solid var(--niebla); border-radius: 14px; padding: 0.8rem; }
  .episodio-mini .rotulo { margin-bottom: 0.4rem; }
  .episodio-mini :global(.play) { width: 38px; height: 38px; }

  /* Secciones */
  .seccion { margin-top: 3.8rem; }
  .cabeza { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: 0.9rem; margin-bottom: 1.4rem; border-bottom: 1px solid var(--niebla); }
  .cabeza h2 { font-size: clamp(1.35rem, 2.2vw, 1.75rem); }
  .cabeza a { font-family: var(--dato); font-size: 0.85rem; font-weight: 600; color: var(--senal); text-decoration: none; white-space: nowrap; }
  .cabeza a:hover { text-decoration: underline; }
  .tres { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }

  .noticias { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .analisis { display: flex; flex-direction: column; gap: 1.5rem; }
  .horizontal { display: grid; grid-template-columns: 220px 1fr; gap: 1.3rem; align-items: start; }
  .horizontal .meta { margin-top: 0.1rem; }
  .bajada { font-size: 0.95rem; color: var(--gris); margin: 0.55rem 0 0; line-height: 1.5; }
  .radar ul { list-style: none; margin: 0 0 1rem; padding: 0; }
  .radar li { padding: 0.75rem 0; border-bottom: 1px solid var(--niebla); }
  .radar li:first-child { padding-top: 0; }
  .radar .meta { margin: 0 0 0.25rem; font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; }
  .pais { display: inline-block; min-width: 1.9em; font-weight: 700; color: var(--senal); }
  .radar li a { color: var(--tinta); text-decoration: none; font-size: 0.96rem; line-height: 1.4; }
  .radar li a:hover { color: var(--senal); }

  .paper { display: flex; flex-direction: column; background: var(--superficie); border: 1px solid var(--niebla); border-radius: 14px; padding: 1.3rem 1.4rem 1.2rem; border-top: 4px solid var(--g, var(--fen)); }
  .paper[data-variante='b'] { --g: #5868EB; }
  .paper[data-variante='c'] { --g: var(--fen-claro); }
  .paper[data-variante='d'] { --g: #8B93FF; }
  .etiquetas { margin-bottom: 0.9rem; }
  .paper .area { margin: auto 0 0; padding-top: 0.8rem; font-family: var(--dato); font-size: 0.76rem; color: var(--gris); }

  .cierre { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; align-items: stretch; }
  .dato { display: block; border-radius: 14px; padding: 1.7rem 1.8rem; background: linear-gradient(135deg, var(--fen), #0D0B70); color: #fff; }
  .dato .rotulo, .dato .meta { color: rgba(255, 255, 255, 0.75); }
  .cifra { font-family: var(--display); font-weight: 700; font-size: clamp(2.6rem, 5vw, 3.6rem); line-height: 1; margin: 0.2rem 0 0.7rem; }
  .dato .texto { margin: 0; font-size: 1.05rem; max-width: 40ch; }
  .cierre :global(.suscripcion) { margin: 0; max-width: none; border-radius: 14px; border-left-width: 0; border: 1px solid var(--niebla); }

  @media (max-width: 960px) {
    .portada-grid, .noticias, .cierre { grid-template-columns: 1fr; }
    .tres { grid-template-columns: 1fr 1fr; }
    .evento :global(.portada) { min-height: 340px; }
  }
  @media (max-width: 620px) {
    .vitrina { padding-top: 1.2rem; }
    .tres { grid-template-columns: 1fr; }
    .horizontal { grid-template-columns: 110px 1fr; gap: 0.9rem; }
    .horizontal .bajada { display: none; }
    .evento { background: #0B1430; }
    .evento :global(.portada) { min-height: 0; height: auto; aspect-ratio: 16 / 10 !important; border-radius: 14px 14px 0 0; }
    .evento-texto { position: static; padding: 1.1rem 1.2rem 1.3rem; background: none; }
    .chip { font-size: 0.66rem; }
    .episodio-mini { grid-template-columns: 120px 1fr; }
    .seccion { margin-top: 2.8rem; }
  }
</style>

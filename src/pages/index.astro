---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const areas = (await getCollection('areas')).sort((a, b) => a.data.orden - b.data.orden);
---

<Base
  portada={true}
  titulo="Inicio"
  descripcion="Observatorio de IA e Innovación en los Negocios, FEN Universidad de Chile. Qué se está descubriendo sobre IA e innovación, y qué de eso sirve realmente a una empresa de la región."
>
  <div class="marco entrada">
    <div class="presentacion">
      <h1>
        Qué se está descubriendo sobre IA e innovación, y qué de eso sirve
        realmente a una empresa de la región.
      </h1>

      <p class="explicacion">
        Seguimos la investigación de punta, evaluamos qué funciona en la
        práctica y lo miramos donde importa: ecosistemas locales y regionales,
        innovación de triple impacto y empresas de menor tamaño. Publicamos
        poco, y cada pieza declara de dónde viene.
      </p>

      <div class="atajos">
        <a href="/metodo/">Cómo trabajamos</a>
        <a href="/datos/">Datos de la región</a>
        <a href="/publicaciones/">Publicaciones</a>
        <a href="/webinars/">Webinars</a>
      </div>
    </div>

    <nav class="areas" aria-label="Áreas de trabajo">
      <p class="rotulo">Áreas de trabajo</p>
      {areas.map((area, i) => (
        <a class="area" href={`/areas/${area.data.slug}/`}>
          <span class="numero">{String(i + 1).padStart(2, '0')}</span>
          <span class="nombre">{area.data.titulo}</span>
        </a>
      ))}
    </nav>
  </div>
</Base>

<style>
  .entrada {
    min-height: calc(100vh - 148px);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: 4rem;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .presentacion h1 {
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    max-width: 20ch;
  }
  .explicacion {
    max-width: 52ch;
    font-size: 1.05rem;
    margin: 1.6rem 0 2rem;
  }
  .atajos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    font-family: var(--dato);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .areas { border-left: 4px solid var(--senal); padding-left: 1.6rem; }
  .rotulo {
    font-family: var(--dato); font-size: 0.7rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gris); margin: 0 0 0.8rem;
  }
  .area {
    display: flex; align-items: baseline; gap: 0.9rem;
    padding: 0.72rem 0; border-bottom: 1px solid var(--niebla);
    text-decoration: none; color: var(--tinta);
  }
  .area:last-child { border-bottom: 0; }
  .area:hover .nombre { color: var(--senal); text-decoration: underline; }
  .numero { font-family: var(--dato); font-size: 0.7rem; color: var(--senal); }
  .nombre { font-family: var(--display); font-weight: 500; font-size: 1.02rem; line-height: 1.25; }

  @media (max-width: 860px) {
    .entrada { grid-template-columns: 1fr; gap: 2.5rem; min-height: 0; padding-top: 3rem; align-items: start; }
  }
</style>

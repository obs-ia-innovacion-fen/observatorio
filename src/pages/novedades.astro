---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

let notas = [];
try { notas = await getCollection('vigilancia'); } catch { notas = []; }
notas.sort((a, b) => new Date(b.data.fecha) - new Date(a.data.fecha));

let prensa = [];
try { prensa = await getCollection('prensa'); } catch { prensa = []; }
prensa.sort((a, b) => new Date(b.data.fecha) - new Date(a.data.fecha));
prensa = prensa.slice(0, 3);
---

<Base
  titulo="Novedades"
  descripcion="Señales recientes en inteligencia artificial e innovación, con su fuente declarada y la lectura del Observatorio."
>
  <div class="marco">
    <h1>Novedades y tendencias</h1>
    <p class="bajada">
      Lo que aparece en la discusión pública sobre estos temas y nos parece que
      importa. Cada señal indica de dónde viene: no es lo mismo un organismo
      internacional, un medio de negocios o alguien contando lo que hizo en su
      empresa. Lo tercero es valioso y llega antes que lo demás, pero no es
      evidencia y lo decimos.
    </p>
    <p class="radar-enlace"><a href="/radar/">Ver el radar de prensa de esta semana</a>: todos los titulares que recolectó el sistema, sin revisión.</p>

    {notas.length === 0 ? (
      <p class="vacio">Todavía no publicamos novedades. Van a aparecer acá.</p>
    ) : (
      notas.map((n) => (
        <article class="nota">
          <p class="fecha">
            {new Date(n.data.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })}
            {n.data.paises?.length > 0 && <span class="paises"> · {n.data.paises.join(' · ')}</span>}
          </p>
          <h2><a href={`/novedades/${n.id}/`}>{n.data.titulo}</a></h2>
        </article>
      ))
    )}

    {prensa.length > 0 && (
      <section class="medios">
        <h2 class="medios-titulo">En los medios</h2>
        <p class="medios-bajada">Apariciones recientes de integrantes del Observatorio.</p>
        {prensa.map((p) => (
          <article class="aparicion">
            <p class="fecha"><span class="medio">{p.data.medio}</span> · {new Date(p.data.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <h3><a href={`/prensa/#${p.id}`}>{p.data.titulo}</a></h3>
          </article>
        ))}
        <p class="todas"><a href="/prensa/">Todas las apariciones</a></p>
      </section>
    )}
  </div>
</Base>

<style>
  .bajada { max-width: 62ch; color: var(--gris); margin: 1.1rem 0 1rem; }
  .radar-enlace { max-width: 62ch; margin: 0 0 2.5rem; color: var(--gris); }
  .radar-enlace a { font-family: var(--display); font-weight: 600; }
  .nota { padding: 1.4rem 0; border-top: 1px solid var(--niebla); }
  .fecha { font-family: var(--dato); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--gris); margin: 0 0 0.5rem; }
  .nota h2 { font-size: 1.2rem; }
  .nota h2 a { color: var(--tinta); text-decoration: none; }
  .nota h2 a:hover { color: var(--senal); }
  .vacio { color: var(--gris); font-style: italic; padding-top: 1.5rem; border-top: 1px solid var(--niebla); }
  .medios { margin-top: 4rem; padding-top: 1.2rem; border-top: 2px solid var(--tinta); }
  .medios-titulo { font-size: clamp(1.4rem, 2.4vw, 1.8rem); }
  .medios-bajada { color: var(--gris); margin: 0.5rem 0 1rem; }
  .aparicion { padding: 1.2rem 0; border-top: 1px solid var(--niebla); }
  .medio { color: var(--fen); }
  .aparicion h3 { font-size: 1.25rem; }
  .aparicion h3 a { color: var(--tinta); text-decoration: none; }
  .aparicion h3 a:hover { color: var(--fen); text-decoration: underline; }
  .todas { margin: 1.2rem 0 0; font-family: var(--dato); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.08em; }
</style>
